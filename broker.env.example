# Copy to broker.env in the repo root. The executor is off when this file is missing.
# The server address is fixed in TradeDeck/BrokerExecutor.cs and points at the local
# fake broker (tools/exec-test/fake_dx.py on 127.0.0.1:8899).
BROKER_USER=demo_user
BROKER_PASS=demo_password
BROKER_ACCOUNT=default:000001
# off | dry | live.  dry logs every request and sends nothing.
BROKER_MODE=dry
BROKER_RISK_PCT=0.5
BROKER_MARKETS=BTCUSDT,ETHUSDT,XRPUSDT
BROKER_MAX_OPEN=2
BROKER_DAILY_STOP_PCT=3.0
BROKER_FLOOR_PCT=6.0
